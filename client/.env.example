# Public API Base URL (must end with /api)
# Production: https://hbs-wear-api.onrender.com/api
# Local development: http://localhost:5000/api
VITE_API_URL=http://localhost:5000/api

# Stripe Publishable Key (pk_test_... or pk_live_...)
# Note: The client can also dynamically retrieve this from the backend /api/payments/stripe/config
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
