# ==========================================
# SERVER ENVIRONMENT & PORT
# ==========================================
NODE_ENV=production
PORT=5000

# ==========================================
# DATABASE (PostgreSQL)
# ==========================================
# Render Internal Database URL (or external for local dev)
# Example: postgresql://hbs_wear_user:password@dpg-xxxx.render.com/hbs_wear
DATABASE_URL="postgresql://user:password@localhost:5432/hbs_wear?schema=public"

# ==========================================
# CORS & FRONTEND ORIGIN
# ==========================================
# Primary production frontend URL (no trailing slash)
CLIENT_URL="https://hbs-wear.vercel.app"

# Optional comma-separated list of additional allowed origins (e.g. preview branches, custom domains)
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# ==========================================
# AUTHENTICATION & ADMIN
# ==========================================
# Strong random secret key for signing JWT tokens (min 32 characters)
JWT_SECRET="generate_a_secure_random_string_min_32_chars"

# Optional initial admin user credentials (used only during manual prisma db seed)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ReplaceWithStrongAdminPassword!"

# ==========================================
# EMAIL PROVIDER (Resend for Email Verification & Password Reset)
# ==========================================
# Resend API Key from https://resend.com/api-keys
RESEND_API_KEY="your_resend_api_key_here"
# Sender email address configured in Resend (e.g. HBS Wear <onboarding@resend.dev> or orders@yourdomain.com)
EMAIL_FROM="HBS Wear <onboarding@resend.dev>"

# ==========================================
# CLOUDINARY (Product Image Uploads)
# ==========================================
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"
CLOUDINARY_FOLDER="hbs-wear/products"

# ==========================================
# STRIPE PAYMENTS
# ==========================================
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Webhook signing secret from Stripe Dashboard -> Webhooks -> Add endpoint (/api/payments/stripe/webhook)
STRIPE_WEBHOOK_SECRET="whsec_..."

# ==========================================
# SAFARICOM DARAJA M-PESA
# ==========================================
DARAJA_CONSUMER_KEY="your_daraja_consumer_key"
DARAJA_CONSUMER_SECRET="your_daraja_consumer_secret"
DARAJA_SHORTCODE="174379"
DARAJA_PASSKEY="your_daraja_passkey"
# Public HTTPS URL where Safaricom sends payment notifications:
DARAJA_CALLBACK_URL="https://hbs-wear-api.onrender.com/api/payments/mpesa/callback"
# 'sandbox' or 'production'
DARAJA_ENVIRONMENT="sandbox"
